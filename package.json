{
  "name": "latic-rfq-collaboration-test",
  "version": "2.1.0-web-beta.5",
  "description": "LATIC询价协作系统局域网内测版",
  "author": "LATIC",
  "repository": {
    "type": "git",
    "url": "https://github.com/HYtonmi0528/turbo-waddle.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "server:init": "node server/scripts/initialize.js",
    "test:collaboration": "node --test tests/collaboration.test.js",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "dev:renderer": "webpack --config webpack.renderer.config.js --mode development --watch",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on dist/renderer/index.html && electron .\"",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:win:portable": "npm run build:renderer && electron-builder --win portable"
  },
  "build": {
    "appId": "com.latic.rfq-collaboration.test",
    "productName": "LATIC询价协作系统-局域网内测",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/main/**/*",
      "server/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{md,ts,map}",
      "!node_modules/**/docs/**",
      "!node_modules/**/test/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LATIC询价协作系统-内测",
      "installerLanguages": [
        "zh-CN"
      ],
      "language": "2052"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/exceljs/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "HYtonmi0528",
      "repo": "turbo-waddle"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "builder-util-runtime": "9.3.1",
    "electron-store": "^8.2.0",
    "electron-updater": "6.6.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.5.4",
    "style-loader": "^3.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
